# URL base da API.
#
# Desenvolvimento local: deixe VAZIO ou comentado. Assim o app usa o proxy do
# Vite definido em vite.config.ts (target http://localhost:8080).
#
# Produção (Vercel): defina nas Environment Variables do projeto com a URL
# pública do backend no Railway. NÃO use barra no final.
#   VITE_API_BASE_URL=https://seu-backend.up.railway.app
VITE_API_BASE_URL=
